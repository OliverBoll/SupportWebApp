@page "/support"

@using Microsoft.AspNetCore.Components.Web
@using SupportWebApp.Models
@using SupportWebApp.Services

@rendermode RenderMode.InteractiveServer

@inject ICosmosDbService CosmosDbService

<PageTitle>Support</PageTitle>

<h1>Support</h1>

<p>Opret en ny supporthenvendelse.</p>


<EditForm Model="@supportMessage"
          OnValidSubmit="@CreateSupportMessage"
          FormName="CreateSupportForm">

    <DataAnnotationsValidator />

    <ValidationSummary />


    <div class="mb-3">

        <label class="form-label">
            Navn
        </label>

        <InputText
            class="form-control"
            @bind-Value="supportMessage.Name" />

        <ValidationMessage
            For="@(() => supportMessage.Name)" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            E-mail
        </label>

        <InputText
            class="form-control"
            @bind-Value="supportMessage.Email" />

        <ValidationMessage
            For="@(() => supportMessage.Email)" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Telefonnummer
        </label>

        <InputText
            class="form-control"
            @bind-Value="supportMessage.Phone" />

        <ValidationMessage
            For="@(() => supportMessage.Phone)" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Kategori
        </label>

        <InputSelect
            class="form-select"
            @bind-Value="supportMessage.Category">

            <option value="">
                Vælg kategori
            </option>

            <option value="Teknisk">
                Teknisk problem
            </option>

            <option value="Konto">
                Konto
            </option>

            <option value="Betaling">
                Betaling
            </option>

            <option value="Andet">
                Andet
            </option>

        </InputSelect>

        <ValidationMessage
            For="@(() => supportMessage.Category)" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Beskrivelse
        </label>

        <InputTextArea
            class="form-control"
            rows="5"
            @bind-Value="supportMessage.Description" />

        <ValidationMessage
            For="@(() => supportMessage.Description)" />

    </div>


    <button
        type="submit"
        class="btn btn-primary"
        disabled="@isSaving">

        @if (isSaving)
        {
            <span>Opretter...</span>
        }
        else
        {
            <span>Opret henvendelse</span>
        }

    </button>

</EditForm>


@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">

        @successMessage

    </div>
}


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">

        @errorMessage

    </div>
}


@code {

    private SupportMessage supportMessage = new();

    private string? successMessage;

    private string? errorMessage;

    private bool isSaving;


    private async Task CreateSupportMessage()
    {
        isSaving = true;

        successMessage = null;
        errorMessage = null;

        try
        {
            await CosmosDbService
                .AddSupportMessageAsync(supportMessage);

            successMessage =
                "Din supporthenvendelse er blevet oprettet.";

            supportMessage =
                new SupportMessage();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Der opstod en fejl: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}