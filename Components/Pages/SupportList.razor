@page "/supportlist"

@using SupportWebApp.Models
@using SupportWebApp.Services
@using Microsoft.AspNetCore.Components.Web

@rendermode RenderMode.InteractiveServer

@inject ICosmosDbService CosmosDbService

<PageTitle>Henvendelser</PageTitle>

<header class="page-header">
    <h1 class="page-title">Henvendelser</h1>
    @if (messages != null && messages.Count > 0)
    {
        <p class="page-lead">@messages.Count i alt</p>
    }
</header>

@if (messages == null)
{
    <p class="state">Indlæser...</p>
}
else if (messages.Count == 0)
{
    <p class="state">Ingen henvendelser fundet.</p>
}
else
{
    <div class="ticket-list">
        @foreach (var message in messages)
        {
            <section class="ticket">
                <div class="ticket-head">
                    <h2 class="ticket-name">@message.Name</h2>
                    <span class="pill">@message.Category</span>
                </div>

                <p class="ticket-desc">@message.Description</p>

                <div class="ticket-meta">
                    <span>@message.Email</span>
                    <span>@message.Phone</span>
                    <span>@message.Date</span>
                </div>
            </section>
        }
    </div>
}

@code {
    private List<SupportMessage>? messages;

    protected override async Task OnInitializedAsync()
    {
        messages = await CosmosDbService.GetSupportMessagesAsync();
    }
}