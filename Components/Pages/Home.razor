@page "/"

<PageTitle>Home</PageTitle>

<section class="hero">
    <h1 class="hero-title">Vi hjælper dig videre.</h1>
    <p class="hero-lead">Opret en henvendelse på få sekunder, og følg med i alle sager ét sted.</p>

    <div class="hero-actions">
        <a class="btn btn-primary" href="support">Opret henvendelse</a>
        <a class="hero-link" href="supportlist">Se henvendelser</a>
    </div>

    <div class="preview" aria-hidden="true">
        <div class="preview-head">
            <span class="preview-name">Eksempel</span>
            <span class="preview-pill">Teknisk</span>
        </div>
        <p class="preview-text">Jeg kan ikke logge ind på min konto. Kan I hjælpe?</p>
        <div class="preview-line"></div>
        <div class="preview-meta">
            <span>navn@email.dk</span>
            <span>20 12 34 56</span>
        </div>
    </div>
</section>

<section class="bento">
    <a class="bento-card bento-primary" href="support">
        <h2 class="bento-title">Opret henvendelse</h2>
        <p class="bento-text">Beskriv dit problem, så vender vi tilbage.</p>
        <span class="bento-cta">Kom i gang</span>
    </a>

    <a class="bento-card" href="supportlist">
        <h2 class="bento-title">Henvendelser</h2>
        <p class="bento-text">Se alle indsendte henvendelser samlet.</p>
        <span class="bento-cta bento-cta-blue">Se oversigt</span>
    </a>
</section>

<section class="steps">
    <h2 class="steps-title">Sådan fungerer det</h2>

    <div class="steps-grid">
        <div class="step">
            <span class="step-num">1</span>
            <h3 class="step-head">Beskriv</h3>
            <p class="step-text">Udfyld formularen med dine oplysninger og en kort beskrivelse.</p>
        </div>
        <div class="step">
            <span class="step-num">2</span>
            <h3 class="step-head">Send</h3>
            <p class="step-text">Din henvendelse bliver gemt med det samme.</p>
        </div>
        <div class="step">
            <span class="step-num">3</span>
            <h3 class="step-head">Følg med</h3>
            <p class="step-text">Find den igen under Henvendelser, når du har brug for den.</p>
        </div>
    </div>
</section>